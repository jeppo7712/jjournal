FROM node:22-alpine
ENV NODE_ENV=development
# REACT_APP_API_URL (the backend's address as reachable from your browser,
# e.g. http://192.168.1.6:3999) is intentionally not set here — this image has
# no COPY step, it's meant to be run with the project directory bind-mounted
# in, so CRA picks it up the same way it would outside Docker: from a local
# .env.development file in the project root (already git-ignored, see
# src/utils/getWebSocketUrl.js for how it's consumed).
EXPOSE 3999
EXPOSE 3000
# See the matching note in Dockerfile — mitigates OOM crashes when rebuilding
# a high-frequency symbol's continuous series (e.g. CL 1M, 10M+ rows).
ENV NODE_OPTIONS=--max-old-space-size=8192
CMD ["npm", "start"]
